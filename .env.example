# Supabase — any of these URL names work (code accepts both):
# SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
#
# Privileged server key — any of these names work:
# SUPABASE_SECRET_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
#
# Optional public anon key (not required by current server admin client):
# SUPABASE_ANON_KEY=...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...

SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
