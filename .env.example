# Supabase — any of these URL names work (code accepts both):
# SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
#
# Privileged server key — any of these names work:
# SUPABASE_SECRET_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
#
# Optional public anon key (not required by current server admin client):
# SUPABASE_ANON_KEY=...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...

SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin dashboard API protection (required for /admin and /api/vehicles*):
# ADMIN_PASSWORD is checked by POST /api/admin/login (httpOnly cookie session).
# Session cookies are signed with ADMIN_SESSION_SECRET if set, otherwise SUPABASE_SECRET_KEY.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Optional machine token alternative to cookie login:
# Authorization: Bearer <ADMIN_API_SECRET>
ADMIN_API_SECRET=
